# API base URL.
# - In development the Vite dev server proxies "/api" → http://localhost:8080,
#   so the default "/api/v1" below works without any configuration.
# - Point to a deployed backend when running against a remote API, e.g.
#   VITE_API_BASE_URL=https://api.example.edu/api/v1
VITE_API_BASE_URL=/api/v1
